# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_URL=http://localhost:8080

# Sentry Error Tracking
# Get this from https://sentry.io after creating a project
# Format: https://xxxxxxxxxxxx@o0000000.ingest.sentry.io/0000000
VITE_SENTRY_DSN=

# App Version (optional, for release tracking in Sentry)
VITE_APP_VERSION=1.0.0

# Server-only Edge Function secrets belong in Supabase secret storage, never in
# a VITE_ variable or committed file. Examples: SUPABASE_SERVICE_ROLE_KEY,
# PODSCAN_API_KEY, OPENAI_API_KEY, RESEND_API_KEY, ANTHROPIC_API_KEY,
# ONBOARDING_CAPABILITY_SECRET, APP_URL/WEB_URL,
# and Google credentials. See docs/workspace-onboarding.md for onboarding.

# Local diagnostic scripts only. Never commit real client identifiers.
DIAGNOSTIC_CLIENT_ID=
DIAGNOSTIC_CLIENT_EMAIL=

# Server-side Supabase Edge Function secret; never expose as VITE_*.
# Host LinkedIn discovery uses the workspace's selected Claude or OpenAI key.
BLITZ_API_KEY=

# Platform-managed provider secrets (set these in Supabase Edge Function secrets).
# Customers choose Claude or OpenAI in Billing and connect their own Instantly key in Client Campaigns.
# OPENAI_API_KEY below is for platform embeddings and optional platform text work.
PODSCAN_API_KEY=""
OPENAI_API_KEY=""
# Optional mailbox/domain provisioning; never requested from customers.
WINNR_API_TOKEN=

# Optional platform-only text generation provider: anthropic or openai.
# Workspace text generation always uses its own selected customer credential.
TEXT_AI_PROVIDER=
